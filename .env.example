# Droide — Provider AI Lengkap seperti opencode (75+ di desktop, 30+ di mobile)
# Cara hubung SAMA PERSIS seperti opencode: /connect → pilih provider → paste API key
# File ini = .env — alternatif isi via UI Settings (DataStore). Pollinations tidak butuh key.

# — Gratis tanpa kartu (bawaan) —
# Pollinations: https://pollinations.ai (tanpa daftar, 1 req/15s)
POLLINATIONS_API_KEY=

# Groq: https://console.groq.com/keys (30 req/menit, tanpa kartu)
GROQ_API_KEY=

# Gemini: https://aistudio.google.com/app/apikey (free tier)
GEMINI_API_KEY=

# OpenRouter Free: https://openrouter.ai/keys (banyak :free)
OPENROUTER_API_KEY=

# Cerebras: https://inference.cerebras.ai
CEREBRAS_API_KEY=

# Hugging Face: https://huggingface.co/settings/tokens
HF_API_KEY=

# Together AI: https://api.together.ai/settings/api-keys
TOGETHER_API_KEY=

# Deep Infra: https://deepinfra.com/dash/api_keys
DEEPINFRA_API_KEY=

# Fireworks: https://app.fireworks.ai
FIREWORKS_API_KEY=

# — Berbayar / populer —
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
XAI_API_KEY=
ZAI_API_KEY=
MOONSHOT_API_KEY=
MINIMAX_API_KEY=
NVIDIA_API_KEY=
AZURE_API_KEY=
BEDROCK_AWS_ACCESS_KEY_ID=
CLOUDFLARE_API_TOKEN=
# Ollama/LM Studio lokal tidak butuh key: http://localhost:11434/v1 , http://localhost:1234/v1

# OpenCode Zen (curated): https://opencode.ai/auth
OPENCODE_ZEN_API_KEY=
