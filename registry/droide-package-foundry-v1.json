{
  "schemaVersion": 1,
  "revision": "release-v1.00-all-visible-families-installable",
  "targetEnvironment": "linux/arm64",
  "policy": {
    "autoPromoteSourceCertification": false,
    "requireIntegrityEvidence": true,
    "requireTransactionalInstall": true,
    "requireRollback": true,
    "requireVersionScopedUninstall": true,
    "visibleExtensionsMustHaveRoutePlan": true
  },
  "routeClasses": {
    "ALPINE_APK": {
      "engine": "guest-apk-transaction",
      "targetProfile": "ALPINE_3_24_MUSL_ARM64",
      "autoProbe": true
    },
    "UBUNTU_GLIBC_ARTIFACT": {
      "engine": "ubuntu-glibc-guest-artifact",
      "targetProfile": "UBUNTU_24_04_GLIBC_ARM64",
      "autoProbe": true
    },
    "STATIC_VENDOR": {
      "engine": "vendor-static-artifact",
      "targetProfile": "ALPINE_3_24_MUSL_ARM64",
      "autoProbe": true
    },
    "BOOTSTRAP_BUNDLE": {
      "engine": "bootstrap-closure-transaction",
      "targetProfile": "ALPINE_3_24_MUSL_ARM64",
      "autoProbe": true
    },
    "UBUNTU_GLIBC_PTRACE": {
      "engine": "ubuntu-glibc-debug-adapter",
      "targetProfile": "UBUNTU_24_04_GLIBC_ARM64",
      "autoProbe": true
    },
    "BUNDLE_PROJECTION": {
      "engine": "shared-bundle-projection",
      "targetProfile": "INHERIT_PRIMARY",
      "autoProbe": true
    }
  },
  "families": [
